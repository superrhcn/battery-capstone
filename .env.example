# Example only: Python scripts do not automatically load this file.
# Set these environment variables explicitly before starting child processes.
# This path is used by existing pilot/verification runners.
BATTERY_OUTPUT_DIR=./outputs

# One numerical thread per process during the first parallel benchmark.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# Start with 2 independent trajectories; increase to 4 only after measurement.
# Worker count is controlled by the launcher, not an implemented env setting.
# Keep passwords, access keys and tokens out of this file.
